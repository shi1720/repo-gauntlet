{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepoGauntlet evaluation report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "candidate", "verdict", "score", "seed", "phases", "artifact_digest", "canonical_digest", "toolchain"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{4,63}$"},
    "candidate": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["PATCH_REJECTED", "BUILD_FAILED", "TEST_FAILED", "QUALITY_FAILED", "TIMEOUT", "INFRA_ERROR", "RESOLVED"]},
    "score": {"type": "number", "minimum": 0, "maximum": 100},
    "seed": {"type": "integer"},
    "artifact_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "canonical_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "duration_ms", "exit_code", "output", "points"],
        "properties": {
          "name": {"enum": ["overlay", "build", "public_tests", "hidden_tests", "quality"]},
          "status": {"enum": ["passed", "failed", "timeout", "infrastructure_error", "rejected", "skipped"]},
          "duration_ms": {"type": "integer", "minimum": 0},
          "exit_code": {"type": "integer"},
          "output": {"type": "string", "maxLength": 8000},
          "points": {"type": "number", "minimum": 0, "maximum": 100}
        }
      }
    },
    "toolchain": {"type": "object", "additionalProperties": {"type": "string"}}
  }
}
