{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepoGauntlet task manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "language", "category", "difficulty", "issue", "source_dir", "candidate_paths", "commands", "limits", "scoring"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{4,63}$"},
    "title": {"type": "string", "minLength": 8, "maxLength": 120},
    "language": {"enum": ["Python", "Java", "Rust", "C++", "TypeScript"]},
    "category": {"enum": ["bug_fix", "feature", "refactor", "performance"]},
    "difficulty": {"enum": ["easy", "medium", "hard", "expert"]},
    "issue": {"type": "string", "minLength": 60},
    "source_dir": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$"},
    "candidate_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$"}},
    "commands": {
      "type": "object", "additionalProperties": false,
      "required": ["build", "public_tests", "hidden_tests", "quality"],
      "properties": {
        "build": {"$ref": "#/$defs/argv"},
        "public_tests": {"$ref": "#/$defs/argv"},
        "hidden_tests": {"$ref": "#/$defs/argv"},
        "quality": {"$ref": "#/$defs/argv"}
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["timeout_seconds", "memory_mb", "processes", "network"],
      "properties": {
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600},
        "memory_mb": {"type": "integer", "minimum": 32, "maximum": 8192},
        "processes": {"type": "integer", "minimum": 1, "maximum": 1024},
        "network": {"const": false}
      }
    },
    "scoring": {
      "type": "object", "additionalProperties": false,
      "required": ["build", "public_tests", "hidden_tests", "quality"],
      "properties": {
        "build": {"type": "integer", "minimum": 0, "maximum": 100},
        "public_tests": {"type": "integer", "minimum": 0, "maximum": 100},
        "hidden_tests": {"type": "integer", "minimum": 0, "maximum": 100},
        "quality": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "seed": {"type": "integer"}
  },
  "$defs": {"argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}
}
